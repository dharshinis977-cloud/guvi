<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dharshini S | Biotechnology Portfolio</title>

<style>
* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {
font-family: Arial, sans-serif;
background: #f5f7fb;
color: #1f2937;
line-height: 1.6;
}

/* Navigation */
nav {
position: sticky;
top: 0;
z-index: 1000;
background: white;
padding: 15px 7%;
display: flex;
justify-content: space-between;
align-items: center;
border-bottom: 1px solid #ddd;
}

.logo {
font-size: 24px;
font-weight: bold;
color: #2563eb;
}

nav ul {
list-style: none;
display: flex;
gap: 20px;
}

nav a {
text-decoration: none;
color: #333;
font-weight: bold;
}

nav a:hover {
color: #2563eb;
}

/* Sections */
section {
padding: 70px 7%;
}

.hero {
min-height: 90vh;
display: flex;
align-items: center;
background: linear-gradient(135deg, #eaf2ff, #ffffff);
}

.hero-content {
max-width: 850px;
}

.tag {
display: inline-block;
background: #dbeafe;
color: #1d4ed8;
padding: 8px 15px;
border-radius: 20px;
font-weight: bold;
margin-bottom: 20px;
}

.hero h1 {
font-size: 60px;
line-height: 1.1;
margin-bottom: 20px;
}

.hero h1 span {
color: #2563eb;
}

.hero p {
max-width: 700px;
font-size: 18px;
color: #555;
}

.buttons {
margin-top: 30px;
display: flex;
gap: 15px;
}

.btn {
display: inline-block;
padding: 12px 22px;
border-radius: 8px;
text-decoration: none;
font-weight: bold;
border: none;
cursor: pointer;
}

.primary {
background: #2563eb;
color: white;
}

.secondary {
background: white;
color: #2563eb;
border: 2px solid #2563eb;
}

/* Section heading */
.section-title {
text-align: center;
margin-bottom: 40px;
}

.section-title h2 {
font-size: 35px;
margin-bottom: 8px;
}

.section-title p {
color: #666;
}

/* Cards */
.card {
background: white;
padding: 25px;
border-radius: 15px;
box-shadow: 0 5px 20px rgba(0,0,0,0.06);
border: 1px solid #e5e7eb;
}

/* About */
.about-grid {
max-width: 1000px;
margin: auto;
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 25px;
}

.card h3 {
margin-bottom: 12px;
}

/* Skills */
.skills-box {
max-width: 1000px;
margin: auto;
}

.skills {
display: flex;
flex-wrap: wrap;
gap: 10px;
}

.skill {
background: #eff6ff;
color: #1d4ed8;
padding: 8px 14px;
border-radius: 20px;
font-weight: bold;
}

/* Projects */
.projects {
max-width: 1100px;
margin: auto;
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 25px;
}

.project-number {
width: 40px;
height: 40px;
display: flex;
justify-content: center;
align-items: center;
background: #2563eb;
color: white;
border-radius: 50%;
font-weight: bold;
margin-bottom: 15px;
}

/* Experience */
.timeline {
max-width: 800px;
margin: auto;
border-left: 3px solid #bfdbfe;
padding-left: 25px;
}

.timeline-item {
margin-bottom: 30px;
position: relative;
}

.timeline-item::before {
content: "";
position: absolute;
left: -34px;
top: 5px;
width: 15px;
height: 15px;
background: #2563eb;
border-radius: 50%;
}

.timeline-item small {
color: #2563eb;
font-weight: bold;
}

/* AI section */
.ai-box {
max-width: 850px;
margin: auto;
text-align: center;
}

textarea,
input {
width: 100%;
padding: 13px;
margin: 8px 0;
border: 1px solid #ccc;
border-radius: 8px;
font-family: Arial;
font-size: 15px;
}

textarea {
min-height: 130px;
}

#aiResult {
display: none;
background: #eff6ff;
padding: 20px;
margin-top: 15px;
border-radius: 10px;
text-align: left;
}

/* Contact */
.contact-grid {
max-width: 1000px;
margin: auto;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 25px;
}

form {
display: grid;
gap: 10px;
}

form button {
background: #2563eb;
color: white;
border: none;
padding: 13px;
border-radius: 8px;
font-weight: bold;
cursor: pointer;
}

#formMessage {
display: none;
color: green;
font-weight: bold;
}

/* Footer */
footer {
background: #111827;
color: white;
text-align: center;
padding: 25px;
}

/* Responsive design */
@media (max-width: 750px) {

nav {
flex-direction: column;
gap: 12px;
}

nav ul {
flex-wrap: wrap;
justify-content: center;
gap: 12px;
}

.hero h1 {
font-size: 42px;
}

.about-grid,
.projects,
.contact-grid {
grid-template-columns: 1fr;
}

section {
padding: 50px 5%;
}
}
</style>
</head>

