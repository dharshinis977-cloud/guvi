<script>

/* Contact form */
document
.getElementById("contactForm")
.addEventListener("submit", function(event) {

event.preventDefault();

document
.getElementById("formMessage")
.style.display = "block";

this.reset();

});


/* AI-assisted activity */
function improveText() {

const input =
document
.getElementById("aiInput")
.value
.trim();

const result =
document
.getElementById("aiResult");


if (input === "") {

result.style.display = "block";

result.innerHTML =
"Please enter a sentence first.";

return;
}


result.style.display = "block";


result.innerHTML =
"<strong>Improved version:</strong><br>" +

"I am a motivated biotechnology student " +
"with a strong interest in applying scientific " +
"knowledge to practical challenges. " +

input.charAt(0).toUpperCase() +
input.slice(1);
}

</script>

